{
  "expo": {
    "scheme": "seagleapp",
    "name": "Seagle",
    "slug": "Seagle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/seagle_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo/seagle_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.seagle.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.seagle.app",
      "icon": "./assets/logo/seagle_logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/seagle_logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/logo/seagle_logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f29b09df-379a-4c0c-87c2-310638bf2dfb"
      }
    }
  }
}
